  {
   "cell_type": "markdown",
   "metadata": {
    "id": "naBwiuebk3hT"
   },
   "source": [
    "![STEP 1 - Preprocessing](https://img.shields.io/badge/STEP%201%20-%20Preprocessing-blue)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 15,
   "metadata": {
    "id": "ebLvwp-4GYgP"
   },
   "outputs": [],
   "source": [
    "#comlete the code\n",
    "import math\n",
    "import numpy as np\n",
    "def preprocess(text):\n",
    "    text = text.lower()\n",
    "    text = ''.join(c if c.isalpha() or c == ' ' else ' ' for c in text)   \n",
    "    tokens = text.split()\n",
    "    tokens = [t for t in tokens if len(t) > 2] \n",
    "    return tokens"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {
    "id": "7oxBvDWD73ab"
   },
   "source": [
    "![STEP 2 - Vocabulary](https://img.shields.io/badge/STEP%202%20-%20Vocabulary-blue)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 5,
   "metadata": {
    "id": "hZ-TUn0OGY4L"
   },
   "outputs": [],
   "source": [
    "#comlete the code\n",
    "def build_vocab(docs):\n",
    "    vocab_set = set()\n",
    "    for doc in docs:\n",
    "        tokens = preprocess(doc)\n",
    "        vocab_set.update(tokens)\n",
    "    return sorted(vocab_set)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {
    "id": "etxivcEYlVnT"
   },
   "source": [
    "[![STEP 3 DF](https://img.shields.io/badge/STEP_3_DF-Document_Frequency-pink)](https://digitalpro.dev)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 6,
   "metadata": {
    "id": "BiDzUEGR8K5P"
   },
   "outputs": [],
   "source": [
    "def compute_df(docs, vocab):\n",
    "    df = {word: 0 for word in vocab}\n",
    "    for doc in docs:\n",
    "        tokens = set(preprocess(doc))   
    "        for word in tokens:\n",
    "            if word in df:\n",
    "                df[word] += 1\n",
    "    return df"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {
    "id": "ErucJMmQ8RZE"
   },
   "source": [
    "[![STEP 4 IDF](https://img.shields.io/badge/STEP_4_IDF-Inverse_Document_Frequency-pink)](https://digitalpro.dev)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 7,
   "metadata": {
    "id": "67mJiYc_8NZv"
   },
   "outputs": [],
   "source": [
    "def compute_idf(df, N):\n",
    "    idf = {}\n",
    "    for word, freq in df.items():\n",
    "        idf[word] = math.log((N + 1) / (freq + 1)) + 1\n",
    "    return idf"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {
    "id": "saYgfcr-8fyQ"
   },
   "source": [
    "[![STEP 5 TF Vector](https://img.shields.io/badge/STEP_5_TF-Term_Frequency_Vector-pink)](https://digitalpro.dev)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 8,
   "metadata": {
    "id": "8WnRmwGd8gUf"
   },
   "outputs": [],
   "source": [
    "def compute_tf(doc, vocab):\n",
    "    tokens = preprocess(doc)\n",
    "    total = len(tokens) if len(tokens) > 0 else 1  # avoid division by zero\n",
    "    tf_vec = np.zeros(len(vocab))\n",
    "    for i, word in enumerate(vocab):\n",
    "        tf_vec[i] = tokens.count(word) / total\n",
    "    return tf_vec"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {
    "id": "KVuJhHQc8mDv"
   },
   "source": [
    "[![STEP 6 TF-IDF Matrix](https://img.shields.io/badge/STEP_6_TFIDF-Build_TF_IDF_Matrix-pink)](https://digitalpro.dev)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 9,
   "metadata": {
    "id": "BAOsjQO_8mh6"
   },
   "outputs": [],
   "source": [
    "def build_tfidf(docs):\n",
    "    vocab = build_vocab(docs)\n",
    "    N = len(docs)\n",
    "    df = compute_df(docs, vocab)\n",
    "    idf = compute_idf(df, N)\n",
    "\n",
    "    idf_vec = np.array([idf[word] for word in vocab])  # shape: (vocab_size,)\n",
    "\n",
    "    tfidf_matrix = np.zeros((N, len(vocab)))\n",
    "    for i, doc in enumerate(docs):\n",
    "        tf_vec = compute_tf(doc, vocab)\n",
    "        tfidf_matrix[i] = tf_vec * idf_vec\n",
    "\n",
    "    return tfidf_matrix, vocab"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {
    "id": "ILXBgwEN8p3W"
   },
   "source": [
    "[![STEP 7 Cosine Similarity](https://img.shields.io/badge/STEP_7-Cosine_Similarity-pink)](https://digitalpro.dev)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 10,
   "metadata": {
    "id": "Im0kjGi18sat"
   },
   "outputs": [],
   "source": [
    "def cosine(a, b):\n",
    "    norm_a = np.linalg.norm(a)\n",
    "    norm_b = np.linalg.norm(b)\n",
    "    if norm_a == 0 or norm_b == 0:\n",
    "        return 0.0\n",
    "    return np.dot(a, b) / (norm_a * norm_b)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {
    "id": "kzTp_RBg8z7k"
   },
   "source": [
    "[![STEP 8 Search Engine](https://img.shields.io/badge/STEP_8-Search_Engine_REAL_VERSION-orange)](https://digitalpro.dev)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 11,
   "metadata": {
    "id": "oOjhALC68pnS"
   },
   "outputs": [],
   "source": [
    "import numpy as np\n",
    "def search(query, docs, top_k=5):\n",
    "    tfidf_matrix, vocab = build_tfidf(docs)\n",
    "\n",
    "    q_vec = np.zeros(len(vocab)) # build query vector\n",
    "    q_words = preprocess(query)\n",
    "\n",
    "    for i, w in enumerate(vocab):\n",
    "        q_vec[i] = q_words.count(w)\n",
    "\n",
    "    if np.sum(q_vec) > 0:\n",
    "        q_vec = q_vec / np.sum(q_vec)\n",
    "\n",
    "    scores = []\n",
    "\n",
    "    for i, doc_vec in enumerate(tfidf_matrix):\n",
    "        score = cosine(q_vec, doc_vec)\n",
    "        scores.append((score, i))\n",
    "\n",
    "    scores.sort(reverse=True)\n",
    "\n",
    "    return scores[:top_k]"
   ]
  },
